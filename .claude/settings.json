{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo doc *)",
      "Bash(cargo run *)",
      "Bash(cargo mutants *)",
      "Bash(scripts/check_vocab.sh *)",
      "Bash(bash -c 'unset \"${!JUST_@}\" && [[ -f justfile && ! -L justfile ]] && exec just --justfile ./justfile fast')",
      "Bash(bash -c 'unset \"${!JUST_@}\" && [[ -f justfile && ! -L justfile ]] && exec just --justfile ./justfile ci')",
      "Bash(just mutants)",
      "Bash(just judge)",
      "Bash(deep-diff-forge *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit * --no-verify *)",
      "Bash(scripts/bless.sh)",
      "Bash(scripts/bless.sh *)",
      "Bash(./scripts/bless.sh *)",
      "Bash(bash scripts/bless.sh *)",
      "Bash(just bless)",
      "Bash(just bless *)",
      "Edit(/.cargo/**)",
      "Edit(/.claude/**)",
      "Edit(/.forgejo)",
      "Edit(/.forgejo/**)",
      "Edit(/.gitea)",
      "Edit(/.gitea/**)",
      "Edit(/.githooks/**)",
      "Edit(/.github)",
      "Edit(/.github/**)",
      "Edit(/.gitlab)",
      "Edit(/.gitlab-ci.yml)",
      "Edit(/.gitlab/**)",
      "Edit(/Cargo.lock)",
      "Edit(/Cargo.toml)",
      "Edit(/agents/**)",
      "Edit(/clippy.toml)",
      "Edit(/crates/*/Cargo.toml)",
      "Edit(/crates/*/clippy.toml)",
      "Edit(/crates/*/tests/**)",
      "Edit(/crates/forge-warden-cli/tests/repo_invariants.rs)",
      "Edit(/crates/forge-warden-doors/src/**)",
      "Edit(/deny.toml)",
      "Edit(/fixtures/**)",
      "Edit(/fixtures/coverage/MANIFEST)",
      "Edit(/justfile)",
      "Edit(/lint-expectations.toml)",
      "Edit(/lint-floor.toml)",
      "Edit(/plants/**)",
      "Edit(/protected-paths.txt)",
      "Edit(/rust-toolchain.toml)",
      "Edit(/rustfmt.toml)",
      "Edit(/schemas/**)",
      "Edit(/scripts/**)",
      "Edit(/warden.toml)",
      "Write(/.cargo/**)",
      "Write(/.claude/**)",
      "Write(/.forgejo)",
      "Write(/.forgejo/**)",
      "Write(/.gitea)",
      "Write(/.gitea/**)",
      "Write(/.githooks/**)",
      "Write(/.github)",
      "Write(/.github/**)",
      "Write(/.gitlab)",
      "Write(/.gitlab-ci.yml)",
      "Write(/.gitlab/**)",
      "Write(/Cargo.lock)",
      "Write(/Cargo.toml)",
      "Write(/agents/**)",
      "Write(/clippy.toml)",
      "Write(/crates/*/Cargo.toml)",
      "Write(/crates/*/clippy.toml)",
      "Write(/crates/*/tests/**)",
      "Write(/crates/forge-warden-cli/tests/repo_invariants.rs)",
      "Write(/crates/forge-warden-doors/src/**)",
      "Write(/deny.toml)",
      "Write(/fixtures/**)",
      "Write(/fixtures/coverage/MANIFEST)",
      "Write(/justfile)",
      "Write(/lint-expectations.toml)",
      "Write(/lint-floor.toml)",
      "Write(/plants/**)",
      "Write(/protected-paths.txt)",
      "Write(/rust-toolchain.toml)",
      "Write(/rustfmt.toml)",
      "Write(/schemas/**)",
      "Write(/scripts/**)",
      "Write(/warden.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
