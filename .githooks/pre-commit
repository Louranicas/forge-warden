#!/usr/bin/env bash
# Installed by `just install-hooks` (git config core.hooksPath .githooks).
# Refuses a commit that would fail the fast gate. Bypassing it with --no-verify only moves the
# failure to CI, where it is public.
set -euo pipefail
while IFS= read -r name; do unset "$name"; done < <(compgen -v GIT_)
root="$(git rev-parse --show-toplevel)"
if [[ -L "$root/scripts" || -L "$root/scripts/ci_fast.sh" || ! -f "$root/scripts/ci_fast.sh" ]]; then
  echo "Gate input refused: scripts/ci_fast.sh" >&2
  exit 2
fi
exec "$root/scripts/ci_fast.sh"
