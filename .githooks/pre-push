#!/usr/bin/env bash
# Runs the full local replica of CI before anything leaves the machine.
set -euo pipefail
while IFS= read -r name; do unset "$name"; done < <(compgen -v GIT_)
root="$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd -P)"
if [[ -L "$root/.git" || ( ! -d "$root/.git" && ! -f "$root/.git" ) ]]; then
  echo "Gate input refused: invalid checkout .git entry" >&2
  exit 2
fi
if [[ ! "$root" -ef . || ! "$root" -ef "$(git -C "$root" rev-parse --show-toplevel)" ]]; then
  echo "Gate input refused: Git worktree differs from the hook checkout" >&2
  exit 2
fi
if [[ -L "$root/scripts" || -L "$root/scripts/ci_local.sh" || ! -f "$root/scripts/ci_local.sh" ]]; then
  echo "Gate input refused: scripts/ci_local.sh" >&2
  exit 2
fi
exec "$root/scripts/ci_local.sh"
